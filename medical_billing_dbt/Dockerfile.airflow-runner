# Build from the tested dbt image; all code is baked into this immutable runner.
FROM medical-billing-dbt:local
WORKDIR /workspace
COPY dbt_project.yml ./dbt_project.yml
COPY config/ ./config/
COPY models/ ./models/
COPY tests/ ./tests/
COPY macros/ ./macros/
# Do NOT copy .env. Credentials are passed at runtime from an env file.
