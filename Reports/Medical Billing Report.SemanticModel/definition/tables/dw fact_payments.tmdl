	/// Days from date of service to payment date
	column days_since_service = VAR svc = LOOKUPVALUE('dw fact_claim_financials'[service_date], 'dw fact_claim_financials'[claim_line_id], 'dw fact_payments'[claim_line_id]) RETURN IF(NOT ISBLANK(svc), INT('dw fact_payments'[payment_date] - svc))
		dataType: int64
		lineageTag: ae2ee10b-0eae-41e8-86aa-2340c89b0f5c
		summarizeBy: none

	partition 'dw fact_payments' = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "MedicalBilling_DW"),
				    dw_fact_payments = Source{[Schema="dw",Item="fact_payments"]}[Data],
				    ActivePayments = Table.SelectRows(dw_fact_payments, each [is_deleted] = false),
				    PaymentColumns = Table.RemoveColumns(ActivePayments, {"is_deleted"})
				in
				    PaymentColumns

	annotation PBI_ResultType = Table

